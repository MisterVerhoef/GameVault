],"isGamingAppOnly":false,"installer":{"type":"WindowsUpdate","id":"9NBLGGH18846"},"skusSummary":[{"msrp":0,"displayMSRP":"Gratis","salePrices":[{"price":0,"displayPrice":"Gratis","badgeId":"default"}]},{}],"releaseDateUtc":"2017-10-13T06:00:46.8771385Z","previews":[{"$type":"Microsoft.Marketplace.Storefront.Contracts.V2.ImageItem, Microsoft.Marketplace.Storefront.Contracts","imageType":"SuperHeroArt","backgroundColor":"","foregroundColor":"","caption":"","imagePositionInfo":"","url":"https://store-images.s-microsoft.com/image/apps.52397.13510798882606697.1816f804-e7fd-4295-9275-23dec3563baf.2ef7ec2d-2e37-489e-b6ac-b5f5e44d429c","height":1080,"width":1920}],"priceInfo":{"msrp":0,"price":0,"badgeText":"NaN","displayPrice":"Gratis","forceToDisplayPrice":false,"narratorText":"NaN Gratis ","ownership":0},"typeTag":"app","ratingCountFormatted":"12K","iconUrl":"https://store-images.s-microsoft.com/image/apps.59178.13510798882606697.b6a31126-a832-4c65-8788-783028e60938.c8191a86-d81c-4af8-acae-b63b99fbe142","posterArtUrl":"https://store-images.s-microsoft.com/image/apps.54354.13510798882606697.7a42c472-75d7-487e-9538-ebb5ce1657e6.372723d8-dd1a-450a-9fed-d420e7705e4e","boxArtUrl":"https://store-images.s-microsoft.com/image/apps.4193.13510798882606697.efaa0e3a-be90-4565-97e8-abea62f547f1.d4ae49f4-d610-49d0-b848-b8151ac46d89","iconUrlBackground":"#0a8ad3","screenshots":[],"encodedTitle":"candy-crush-saga","isApplication":false,"isGame":true,"isTvSeries":false,"isMovie":false,"isMoviesOrTVs":false,"isPwa":false,"isTheme":false,"isCoreGame":false,"isAllowed":true,"isBrowsable":false,"isPurchaseEnabled":false,"isAd":false,"isSparkProduct":false,"isAndroid":false,"isHardware":false,"isSubscription":false,"isTencent":false,"isTencentMini":false,"pageTitleLocalization":"Common.PageGameFreeTitle","disableDownload":false,"cardActions":["Update","Install","Purchase","Launch"],"productRatings":[{"ratingSystem":"Pan European Game Information","ratingSystemShortName":"PEGI","ratingSystemId":"PEGI","ratingSystemUrl":"https://pegi.info","ratingValue":"PEGI 3","ratingId":"PEGI:3","ratingValueLogoUrl":"https://store-images.s-microsoft.com/image/global.4635.image.6f55bab8-d894-46ea-94d9-4ad102009096.4211468b-3c13-4a63-9bd3-07385b207b19","ratingAge":3,"restrictMetadata":false,"restrictPurchase":false,"ratingDescriptors":[],"ratingDisclaimers":[],"interactiveElements":["In-game aankopen"],"longName":"PEGI 3","shortName":"PEGI 3","description":"3 jaar en ouder","hasInAppPurchases":true}]},{"productId":"9nblggh3vrmz","title":"Township","description":"BOUW DE STAD VAN JE DROMEN!\n\nWelkom in Township, een spannende combinatie van stadsbouw en landbouw waarin jij de burgemeester van je eigen stad bent!\nBouw huizen, fabrieken en buurtgebouwen, verbouw gewassen op je boerderij en leg je stad aan precies zoals jij dat wilt. Doe mee aan tijdelijke evenementen en zeilwedstrijden en win exclusieve beloningen!\n\nWil je even iets anders doen dan je stad uitbreiden? Ga dan leuke 3-op-een-rij-puzzels doen en verdien beloningen, versnel je voortgang en speel nog meer leuke evenementen vrij die zelfs offline beschikbaar zijn!\nTownship biedt de perfecte mix van stadsbouw, landbouw en match-3-gameplay!\n\nBELANGRIJKSTE FUNCTIES:\n● Ongelimiteerde creativiteit: ontwerp en bouw de stad van je dromen!\n● Leuke 3-op-een-rij-puzzels: voltooi uitdagende levels, verdien beloningen en breid je stad sneller uit!\n● Spannende competities: daag spelers van over de hele wereld uit in toernooien, win prijzen en maak onvergetelijke herinneringen!\n● Exclusieve verzamelobjecten: verzamel waardevolle artefacten, zeldzame antiquiteiten en kleurrijke profielafbeeldingen om je prestaties te tonen!\n● Offline optie: speel Township waar en wanneer je maar wilt, ook zonder internetverbinding!\n● Levendige community: maak kennis met vriendelijke personages, ieder met hun eigen unieke karakter!\n● Sociale connecties: speel met je vrienden van Facebook, of maak nieuwe vrienden binnen de Township-community!\n\nJe zult Township geweldig vinden:\n● Een unieke mix van stadsleven, buitenleven en puzzelen\n● Prachtige graphics en levendige animaties\n● Regelmatige updates met nieuwe content en speciale evenementen\n● Eindeloze manieren om jouw stad te personaliseren met verschillende decoraties\n\nJe kunt Township gratis spelen, hoewel bepaalde spelelementen (inclusief willekeurige items) met echt geld kunnen worden aangekocht. \n\nJe hebt geen wifi- of internetverbinding nodig om te spelen.\n *Je hebt wel een internetverbinding nodig om toegang te krijgen tot wedstrijden en extra functies.\n\nVind jij Township leuk? Volg ons dan!\nFacebook: facebook.com/TownshipMobile\nInstagram: instagram.com/township_mobile/\n\nWil je een probleem melden of een vraag stellen? Neem contact op met Player Support via het spel door naar Instellingen > Hulp en ondersteuning te gaan. Als je geen toegang hebt tot het spel, gebruik dan de webchat door op het chatpictogram rechts onderaan onze website te klikken: https://playrix.helpshift.com/hc/nl/3-township/\n\nPrivacybeleid:\nhttps://playrix.com/privacy/index_nl.html\nGebruiksvoorwaarden:\nhttps://playrix.com/terms/index_nl.html\n\n","categories":["Simulatie","Strategie"],"publisherName":"Playrix","images":[{"imageType":"logo","backgroundColor":"transparent","foregroundColor":"","caption":"","imagePositionInfo":"","url":"https://store-images.s-microsoft.com/image/apps.2554.13510798884725076.b30ce452-8444-4303-a108-ca46b5391cd1.c7808d17-bec8-4569-9444-dc67b9b9abc2","height":100,"width":100},{"imageType":"tile","backgroundColor":"transparent","foregroundColor":"","caption":"","imagePositionInfo":"","url":"https://store-images.s-microsoft.com/image/apps.37968.13510798884725076.b30ce452-8444-4303-a108-ca46b5391cd1.55e7f38e-159d-43fe-a3a9-5eac423d50d3","height":150,"width":150},{"imageType":"tile","backgroundColor":"transparent","foregroundColor":"","caption":"","imagePositionInfo":"","url":"https://store-images.s-microsoft.com/image/ap