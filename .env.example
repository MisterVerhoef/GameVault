# GameVault environment variables
#
# The site reads the checked-in catalogue in public/catalog/.
# `npm run build`, `npm run start`, and a Vercel deployment do not need
# any of these variables. Leave them unset in the Vercel project.
#
# Set the IGDB variables only when running `npm run catalogue:sync:igdb`
# locally, or as GitHub Actions secrets for .github/workflows/catalogue.yml.
# Never prefix them with NEXT_PUBLIC_ and never commit real values.

# Twitch application credentials used to call the IGDB API. Sync only.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Optional. Stored on the imported catalogue as provenance. Defaults to today's date.
# IGDB_SOURCE_VERSION=

# Optional sync bounds. Defaults: 500 games per page, 5 pages, refuse catalogues smaller than 5.
# IGDB_LIMIT=500
# IGDB_PAGES=5
# IGDB_MIN_GAMES=5

# Optional comma-separated franchise searches merged into the popular-page results.
# IGDB_SEARCH_TERMS=halo,the witcher

# Optional IGDB API query. When set, replaces the built-in popular-games query.
# IGDB_QUERY=
